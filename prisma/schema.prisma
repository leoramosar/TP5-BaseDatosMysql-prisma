generator client {
  provider           = "prisma-client"
  output             = "../generated/prisma"
  importFileExtension = "ts"
}

datasource db {
  provider = "mysql"
}

model categorias {
  id          Int         @id @default(autoincrement())
  nombre      String      @unique(map: "nombre") @db.VarChar(80)
  descripcion String?     @db.VarChar(200)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  productos   productos[]
}

model clientes {
  id        Int       @id @default(autoincrement())
  nombre    String    @db.VarChar(100)
  cuit      String?   @unique(map: "cuit") @db.VarChar(20)
  telefono  String?   @db.VarChar(30)
  email     String?   @unique(map: "email") @db.VarChar(100)
  direccion String?   @db.VarChar(200)
  activo    Boolean   @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  pedidos   pedidos[]
}

model companias_envios {
  id         Int      @id @default(autoincrement())
  nombre     String   @db.VarChar(100)
  telefono   String?  @db.VarChar(30)
  costo_base Decimal  @db.Decimal(10, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  envios     envios[]
}

model detalle_pedido {
  id              Int       @id @default(autoincrement())
  id_pedido       Int
  id_producto     Int
  cantidad        Int
  precio_unitario Decimal   @db.Decimal(10, 2)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  pedidos         pedidos   @relation(fields: [id_pedido], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "detalle_pedido_ibfk_1")
  productos       productos @relation(fields: [id_producto], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "detalle_pedido_ibfk_2")

  @@unique([id_pedido, id_producto], map: "uk_pedido_producto")
  @@index([id_producto], map: "id_producto")
}

model empleados {
  id            Int       @id @default(autoincrement())
  nombre        String    @db.VarChar(100)
  apellido      String    @db.VarChar(100)
  puesto        String    @db.VarChar(60)
  salario       Decimal   @db.Decimal(10, 2)
  fecha_ingreso DateTime  @db.Date
  activo        Boolean   @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  pedidos       pedidos[]
}

model envios {
  id               Int              @id @default(autoincrement())
  id_pedido        Int              @unique(map: "id_pedido")
  id_compania      Int
  direccion        String           @db.VarChar(200)
  fecha_envio      DateTime?        @db.Date
  estado           envios_estado    @default(preparando)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  pedidos          pedidos          @relation(fields: [id_pedido], references: [id], onUpdate: Cascade, onDelete: Restrict, map: "envios_ibfk_1")
  companias_envios companias_envios @relation(fields: [id_compania], references: [id], onUpdate: Cascade, onDelete: Restrict, map: "envios_ibfk_2")

  @@index([id_compania], map: "id_compania")
}

model pedidos {
  id             Int              @id @default(autoincrement())
  fecha          DateTime         @db.Date
  id_cliente     Int
  id_empleado    Int
  
  estado         pedidos_estado   @default(pendiente)
  
  numero_factura String?          @unique
  fecha_factura  DateTime?        @db.Date
  subtotal       Decimal?         @db.Decimal(10, 2)
  iva            Decimal?         @db.Decimal(10, 2)
  total          Decimal?         @db.Decimal(10, 2)

  detalle_pedido detalle_pedido[]
  envios         envios?
  
  clientes       clientes         @relation(fields: [id_cliente], references: [id], onUpdate: Cascade, onDelete: Restrict, map: "pedidos_ibfk_1")
  empleados      empleados        @relation(fields: [id_empleado], references: [id], onUpdate: Cascade, onDelete: Restrict, map: "pedidos_ibfk_2")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([id_cliente], map: "id_cliente")
  @@index([id_empleado], map: "id_empleado")
}

model productos {
  id             Int              @id @default(autoincrement())
  nombre         String           @db.VarChar(100)
  precio         Decimal          @db.Decimal(10, 2)
  stock          Int              @default(0)
  id_categoria   Int?
  id_proveedor   Int?
  activo         Boolean          @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  detalle_pedido detalle_pedido[]
  
  categorias     categorias?      @relation(fields: [id_categoria], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "productos_ibfk_1")
  proveedores    proveedores?     @relation(fields: [id_proveedor], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "productos_ibfk_2")

  @@index([id_categoria], map: "id_categoria")
  @@index([id_proveedor], map: "id_proveedor")
}

model proveedores {
  id        Int         @id @default(autoincrement())
  nombre    String      @db.VarChar(100)
  cuit      String      @unique(map: "cuit") @db.VarChar(20)
  telefono  String?     @db.VarChar(30)
  email     String?     @unique(map: "email") @db.VarChar(100)
  direccion String?     @db.VarChar(200)
  activo    Boolean     @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  productos productos[]
}

model user {
  id        Int         @id @default(autoincrement())
  nombre    String      @db.VarChar(100)
  email     String?     @unique(map: "email") @db.VarChar(150)
  password  String?     @db.VarChar(255)
  rol       Role        @default(USER)
  activo    Boolean     @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@map ("users")
}

enum Role {
  ADMIN
  USER
}

enum envios_estado {
  preparando
  en_camino  @map("en camino")
  entregado
  cancelado
}

// estado del pedido (no del envio)
enum pedidos_estado {
  pendiente
  confirmado
  facturado
  cancelado
}