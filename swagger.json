      "post": {
        "tags": ["Usuarios"],
        "summary": "Registrar usuario",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "nombre": { "type": "string" },
                  "email": { "type": "string" },
                  "password": { "type": "string" }
                }
              },
              "example": {
                "nombre": "Emmanuel",
                "email": "emmanuel@test.com",
                "password": "password123"
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Usuario creado" }
        }
      }
    },
